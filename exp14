import cv2
import numpy as np

# Step 1: Read input image
img = cv2.imread("image.jpg")

if img is None:
    print("Image not found")
    exit()

# Get image dimensions
height, width = img.shape[:2]

# Step 2: Define four source points
# (Change these points according to your image)
src_points = np.float32([
    [0, 0],                 # Top-left
    [width-1, 0],           # Top-right
    [0, height-1],          # Bottom-left
    [width-1, height-1]     # Bottom-right
])

# Step 3: Define destination points
dst_points = np.float32([
    [100, 50],
    [width-100, 0],
    [0, height-50],
    [width, height]
])

# Step 4: Calculate Homography Matrix
H, status = cv2.findHomography(src_points, dst_points)

print("Homography Matrix:")
print(H)

# Step 5: Apply perspective transformation
result = cv2.warpPerspective(img, H, (width, height))

# Step 6: Display images
cv2.imshow("Original Image", img)
cv2.imshow("Homography Transformation", result)

# Save output
cv2.imwrite("homography_output.jpg", result)

cv2.waitKey(0)
cv2.destroyAllWindows()
