# perspective_transform.py

import cv2
import numpy as np

# Read input image
image = cv2.imread("image.jpg")

if image is None:
    print("Error: Cannot load image")
    exit()

# Get image size
height, width = image.shape[:2]

# Display original image
cv2.imshow("Original Image", image)

# Select four points from the image
# Change these coordinates according to your image

source_points = np.float32([
    [50, 50],                 # Top Left
    [width-50, 50],           # Top Right
    [width-50, height-50],    # Bottom Right
    [50, height-50]           # Bottom Left
])

# Destination points (desired output rectangle)

destination_points = np.float32([
    [0, 0],
    [width, 0],
    [width, height],
    [0, height]
])

# Calculate perspective transformation matrix
transform_matrix = cv2.getPerspectiveTransform(
    source_points,
    destination_points
)

# Apply perspective transformation
transformed_image = cv2.warpPerspective(
    image,
    transform_matrix,
    (width, height)
)

# Display result
cv2.imshow("Perspective Transformed Image", transformed_image)

# Save output
cv2.imwrite("perspective_output.jpg", transformed_image)

print("Perspective Transformation Completed")
print("Output saved as perspective_output.jpg")

# Wait and close windows
cv2.waitKey(0)
cv2.destroyAllWindows()
