import cv2

# Read image
img = cv2.imread("image.jpg")

# Check image
if img is None:
    print("Error: image.jpg not found")
    exit()

# Get image dimensions
height, width = img.shape[:2]

# Crop size
crop_size = min(100, height // 4, width // 4)

# Crop image
crop = img[20:20 + crop_size, 20:20 + crop_size]

# Copy cropped image
copy = crop.copy()

# Paste position
x = width - crop_size - 20
y = height - crop_size - 20

# Paste copied image
img[y:y + crop_size, x:x + crop_size] = copy

# Save output
cv2.imwrite("Cropping_Copying_Pasting.jpg", img)

# Display result
cv2.imshow("Cropping, Copying and Pasting", img)

cv2.waitKey(0)
cv2.destroyAllWindows()
