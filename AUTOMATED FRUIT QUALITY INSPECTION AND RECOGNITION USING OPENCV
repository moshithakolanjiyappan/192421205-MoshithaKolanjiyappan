import cv2 
import numpy as np 
import os 
IMAGE_SIZE = 640 
DEFECT_THRESHOLD = 0.008 
os.makedirs("results", exist_ok=True) 
def inspect_banana(image, x1, x2, number): 
 roi = image[:, x1:x2] 
 hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV) 
 mask = cv2.inRange( 
 hsv, 
 np.array([0, 35, 30]), 
 np.array([179, 255, 255]) 
 )
 kernel = np.ones((5, 5), np.uint8) 
 mask = cv2.morphologyEx( 
 mask, 
 cv2.MORPH_OPEN, 
 kernel 
 ) 
 mask = cv2.morphologyEx( 
 mask, 
 cv2.MORPH_CLOSE, 
 kernel 
 ) 
 contours, _ = cv2.findContours(  mask, 
 cv2.RETR_EXTERNAL, 
 cv2.CHAIN_APPROX_SIMPLE  ) 
 if not contours: 
 return image, "NOT DETECTED", 0 
 contour = max( 
 contours, 
 key=cv2.contourArea 
 ) 
 area = cv2.contourArea(contour) 
 if area < 1000: 
 return image, "NOT DETECTED", 0
 bx, by, bw, bh = cv2.boundingRect(contour) 
 banana_mask = np.zeros( 
 mask.shape, 
 dtype=np.uint8 
 ) 
 cv2.drawContours( 
 banana_mask, 
 [contour], 
 -1, 
 255, 
 -1 
 ) 
 gray = cv2.cvtColor( 
 roi, 
 cv2.COLOR_BGR2GRAY 
 ) 
 dark = cv2.inRange( 
 gray, 
 0, 
 85 
 ) 
 saturated = cv2.inRange( 
 hsv, 
 np.array([0, 40, 0]), 
 np.array([179, 255, 255]) 
 ) 
 defect_mask = cv2.bitwise_and( 
 dark, 
 saturated
 ) 
 defect_mask = cv2.bitwise_and( 
 defect_mask, 
 banana_mask 
 ) 
 defect_mask = cv2.morphologyEx(  defect_mask, 
 cv2.MORPH_OPEN, 
 np.ones((3, 3), np.uint8) 
 ) 
 banana_area = cv2.countNonZero(  banana_mask 
 ) 
 defect_area = cv2.countNonZero(  defect_mask 
 ) 
 if banana_area > 0: 
 defect_ratio = defect_area / banana_area  else: 
 defect_ratio = 0 
 if defect_ratio >= DEFECT_THRESHOLD:  quality = "DEFECTIVE" 
 box_color = (0, 0, 255) 
