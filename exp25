import cv2
import numpy as np

img = cv2.imread("image.jpg")

gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

gx = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=3)
gy = cv2.Sobel(gray, cv2.CV_64F, 0, 1, ksize=3)

gradient = cv2.magnitude(
    gx.astype(np.float32),
    gy.astype(np.float32)
)

gradient = cv2.normalize(
    gradient, None, 0, 255, cv2.NORM_MINMAX
).astype(np.uint8)

output = cv2.addWeighted(gray, 1.0, gradient, 1.0, 0)

cv2.imwrite("Gradient_Masking_Sharpening.jpg", output)

cv2.imshow("Gradient Masking Sharpening", output)

cv2.waitKey(0)
cv2.destroyAllWindows()
