import cv2
import numpy as np

# Read input image
img = cv2.imread("image.jpg")

# Check image loading
if img is None:
    print("Image not found")
    exit()

# Get image size
height, width = img.shape[:2]

# Source points (points selected from original image)
src_points = np.float32([
    [50, 50],
    [width-50, 50],
    [50, height-50],
    [width-50, height-50]
])

# Destination points (new transformed position)
dst_points = np.float32([
    [100, 80],
    [width-100, 50],
    [80, height-100],
    [width-80, height-50]
])

# Create DLT matrix
A = []

for i in range(4):
    x, y = src_points[i]
    u, v = dst_points[i]

    A.append([
        -x, -y, -1,
        0, 0, 0,
        x*u, y*u, u
    ])

    A.append([
        0, 0, 0,
        -x, -y, -1,
        x*v, y*v, v
    ])

A = np.array(A)

# Solve using SVD
U, S, V = np.linalg.svd(A)

# Homography matrix
H = V[-1].reshape(3, 3)

# Normalize matrix
H = H / H[2, 2]

print("Homography Matrix:")
print(H)

# Apply DLT transformation
transformed_image = cv2.warpPerspective(
    img,
    H,
    (width, height)
)

# Display output
cv2.imshow("Original Image", img)

cv2.imshow(
    "DLT Transformed Image",
    transformed_image
)

# Save result
cv2.imwrite(
    "dlt_output.jpg",
    transformed_image
)

print("Transformation completed successfully")
print("Output saved as dlt_output.jpg")

cv2.waitKey(0)
cv2.destroyAllWindows()
